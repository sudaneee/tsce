# Copy to backend/.env and fill in. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=portal.tsce.edu.ng
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.tsce.edu.ng
NUM_PROXIES=1
# DJANGO_HSTS_SECONDS=3600

# --- Paths (defaults are inside backend/) ---
# SQLITE_PATH=/var/lib/tsce/db.sqlite3
# MEDIA_ROOT=/var/lib/tsce/media
# PRIVATE_MEDIA_ROOT=/var/lib/tsce/private_media
# STATIC_ROOT=/var/www/tsce/static

# --- Email (console until TSCE provides a mailbox) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=TSCE <no-reply@tsce.edu.ng>

# --- Payments: simulator | zainpay ---
# The simulator is refused in production unless ALLOW_PAYMENT_SIMULATOR=true (demo servers only).
PAYMENT_GATEWAY=zainpay
ZAINPAY_ENVIRONMENT=sandbox          # sandbox | live  (sets the API base URL)
# ZAINPAY_BASE_URL=                  # override: https://sandbox.zainpay.ng | https://api.zainpay.ng
# --- Fill these in from the Zainpay merchant dashboard (never commit real values) ---
ZAINPAY_PUBLIC_KEY=                  # JWT "public key" (Bearer token for API calls)
ZAINPAY_SECRET_KEY=                  # verifies the Zainpay-Signature header on webhooks
ZAINPAY_ZAINBOX_CODE=                # the zainbox created for TSCE
ZAINPAY_CALLBACK_URL=https://portal.tsce.edu.ng/api/payments/zainpay/callback
# Webhook URL to register in the Zainpay dashboard: https://portal.tsce.edu.ng/api/payments/zainpay/webhook
ZAINPAY_PAYER_CHARGE=300             # naira transaction charge paid by the payer (0 = TSCE absorbs it)
ZAINPAY_CHANNELS=bank_transfer       # comma-separated; empty = every channel Zainpay offers
# ZAINPAY_RECONCILE_LOOKBACK_HOURS=720
